DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/roamconsensus"
# Optional photo/embed providers; without them the photo API falls back to placeholders.
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""
META_OEMBED_TOKEN=""
# Neon: direct (non-pooled) URL for migrations. Optional locally.
DIRECT_DATABASE_URL=""
# Google sign-in (Google Cloud > APIs & Services > Credentials > OAuth client ID). Without both, sign-in is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: signs login cookies (falls back to one made from ADMIN_PASSWORD). BETTER_AUTH_URL defaults to URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
