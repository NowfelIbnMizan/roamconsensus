{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/migrate-deploy.sh && npx prisma db seed && npm run build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)*.md' ':(exclude)shots-lab'",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/alerts",
      "schedule": "0 7 * * *"
    }
  ]
}
