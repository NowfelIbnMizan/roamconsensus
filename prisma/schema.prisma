generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  BACKPACKER
  BUDGET
  MIDRANGE
  LUXURY
}

enum ItemCategory {
  STAY
  EXPERIENCE
  FOOD
  ESIM
  GEAR
  TRANSIT
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  BLOG
}

enum CouponType {
  PLATFORM // our link + our exclusive code
  PUBLIC // our link + public brand promo
  CREATOR // creator's link + creator code (attribution kept)
}

enum Sentiment {
  MUST_VISIT
  RECOMMENDED
  OPTIONAL
  AVOID
}

enum Crowd {
  LOW
  MEDIUM
  HIGH
}

/// "Best time to go": typical weather and crowds for one month of the year.
model DestinationMonth {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  /// 1 = January.
  month         Int
  highC         Int?
  lowC          Int?
  rainMm        Int?
  crowd         Crowd?
  note          String?

  @@unique([destinationId, month])
}

/// "Before you go": one practical checklist entry (visa, money, health…).
model DestinationTip {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  /// Group heading, e.g. "Entry" or "Health".
  topic         String
  title         String
  body          String
  sourceUrl     String?
  position      Int         @default(0)
}

enum PhotoSource {
  OTA
  OEMBED
  WEBSITE
  UNSPLASH
  PEXELS
  PLACEHOLDER
  /// Picked by hand in admin (the place's first photo link); never replaced by a search.
  MANUAL
}

model Destination {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  country          String
  summary          String
  heroPhotoUrl     String?
  /// Fictional demo content; the site shows a banner on it.
  isSample         Boolean            @default(false)
  /// Where the month-by-month weather figures come from.
  climateSourceUrl String?
  places           Place[]
  itineraries      Itinerary[]
  posts            Post[]
  months           DestinationMonth[]
  tips             DestinationTip[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Creator {
  id             String          @id @default(cuid())
  handle         String          @unique
  name           String
  platform       Platform
  /// Main link: where the creator's name button goes.
  profileUrl     String
  instagramUrl   String?
  facebookUrl    String?
  xUrl           String?
  tiktokUrl      String?
  youtubeUrl     String?
  pinterestUrl   String?
  websiteUrl     String?
  avatarUrl      String?
  bio            String?
  itineraries    Itinerary[]
  coupons        Coupon[]
  affiliateLinks AffiliateLink[]
  createdAt      DateTime        @default(now())
}

model Itinerary {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  summary       String
  tier          Tier
  days          Int
  sourceUrl     String
  /// The site owner's own commentary on this itinerary ("Nowfel's take"). Written in the admin panel.
  editorTake    String?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items         Item[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
  @@index([creatorId])
}

/// A canonical spot shared across creators. Consensus = distinct creators whose items point at the same Place.
model Place {
  id            String       @id @default(cuid())
  slug          String
  name          String
  category      ItemCategory
  /// Neighbourhood or island, e.g. "Ubud" or "Nusa Penida".
  area          String?
  /// One or two sentences: what it is and why it's worth knowing (history, fame).
  blurb         String?
  tip           String?
  /// Venue's own site; its share image (og:image) is used as the place photo.
  website       String?
  /// Photo links added in admin. The first is the place's main photo; all show first in its gallery.
  photos        String[]     @default([])
  /// Map pin. Approximate is fine; travellers get "Open in Google Maps" for exact directions.
  lat           Float?
  lng           Float?
  /// Shut for good (or for a long refurbishment). Stays on creators' routes with a "Closed" label, left out of costs.
  closed        Boolean      @default(false)
  /// When someone last checked it is still open (Google Maps or its own site).
  checkedAt     DateTime?
  destinationId String
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  items         Item[]

  @@unique([destinationId, slug])
}

model Item {
  id             String          @id @default(cuid())
  day            Int
  position       Int
  name           String
  note           String?
  category       ItemCategory
  priceCents     Int? // null = creator didn't give a price
  priceNote      String? // creator's own wording, e.g. "a couple bucks a day"
  sentiment      Sentiment?
  currency       String          @default("USD")
  /// Where we found the price when the creator didn't give one (official site, ticket office, booking platform).
  priceSourceUrl String?
  /// When that researched price was last checked; shown as "checked Oct 2026". Set with no price = no source lists one.
  priceCheckedAt DateTime?
  unit           String? // "night", "person", "day"
  quantity       Int             @default(1)
  itineraryId    String
  itinerary      Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  placeId        String?
  place          Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)
  vendorId       String?
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  links          AffiliateLink[]

  @@index([itineraryId, day, position])
  @@index([placeId])
}

model Vendor {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  homepage       String
  items          Item[]
  affiliateLinks AffiliateLink[]
  coupons        Coupon[]
}

/// creatorId null = our platform deep link; set = creator's original link.
model AffiliateLink {
  id        String   @id @default(cuid())
  url       String
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id])

  @@index([itemId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String
  type        CouponType
  description String?
  vendorId    String
  vendor      Vendor     @relation(fields: [vendorId], references: [id])
  creatorId   String?
  creator     Creator?   @relation(fields: [creatorId], references: [id])
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean    @default(true)

  @@index([vendorId, type, active])
}

/// One eSIM data plan for a country, loaded from data/esim/*.json.
model EsimPlan {
  id         String   @id @default(cuid())
  country    String
  provider   String
  name       String
  /// Null = unlimited.
  dataMb     Int?
  days       Int
  priceCents Int
  currency   String   @default("USD")
  network    String?
  speed      String?
  hotspot    Boolean?
  notes      String?
  url        String
  sourceUrl  String?
  checkedAt  DateTime

  @@index([country])
}

model PhotoCache {
  id          String      @id @default(cuid())
  key         String      @unique
  source      PhotoSource
  url         String
  attribution String?
  /// Photographer's profile page, linked from the credit line.
  creditUrl   String?
  fetchedAt   DateTime    @default(now())
}

/// Content the deploy seed has already loaded once ("itinerary:<slug>", "destination:<slug>"), so new entries in data/
/// get added on deploy while anything edited or deleted in the admin panel stays that way.
model SeedLog {
  key      String   @id
  loadedAt DateTime @default(now())
}

/// The person behind the site, shown on /about and next to their takes on itineraries. One row, id "me".
model Editor {
  id           String   @id @default("me")
  name         String
  tagline      String?
  /// Paragraphs separated by blank lines.
  bio          String
  photoUrl     String?
  email        String?
  instagramUrl String?
  updatedAt    DateTime @updatedAt
}

/// People who signed up for email: from the footer form, or by asking for their trip plan by email.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  /// Where they signed up: "footer" or "trip".
  source         String
  /// Last trip plan link they asked to have emailed.
  tripUrl        String?
  lastEmailedAt  DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Blog posts, written in Admin > Blog. Body is simple Markdown (headings, lists, links, images, bold/italic).
model Post {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  /// One or two sentences for the blog list, search results and share previews.
  excerpt       String?
  body          String
  coverUrl      String?
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  published     Boolean      @default(false)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([published, publishedAt])
}

/// Travellers who signed in with Google. The four auth tables follow Better Auth's schema (src/lib/auth.ts).
model User {
  id              String           @id
  name            String
  email           String           @unique
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]
  cart            UserCart?
  trips           SavedTrip[]
  favourites      FavouritePlace[]
  groupsOwned     GroupTrip[]
  groups          GroupMember[]
  groupItems      GroupItem[]
  groupVotes      GroupVote[]
  /// Daily email when prices in their cart change or creators add routes for their cart's cities. Off until they opt in.
  alertsEnabled   Boolean          @default(false)
  /// Last alert check; only routes added after it count as new.
  alertsCheckedAt DateTime?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// The signed-in traveller's trip cart, kept in step with the cart in their browser so it follows them across devices.
model UserCart {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The cart as the browser stores it: items, budget, trip days, start date, packed and done lists.
  data        Json
  /// Item id -> price (cents) when the last alert email went out, to spot price changes since.
  alertPrices Json?
  updatedAt   DateTime @updatedAt
}

/// Named copies of a cart the traveller kept on their "My trips" page.
model SavedTrip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Places a signed-in traveller hearted. Keyed by slugs, with a copy of the name so the list reads without a join.
model FavouritePlace {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination     String
  destinationName String
  place           String
  name            String
  category        ItemCategory
  area            String?
  createdAt       DateTime     @default(now())

  @@unique([userId, destination, place])
}

/// A trip planned together: anyone with the invite link can join, add stops and vote on them.
model GroupTrip {
  id          String        @id @default(cuid())
  name        String
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Secret part of the invite link; the owner can make a new one to stop old links working.
  inviteToken String        @unique
  members     GroupMember[]
  items       GroupItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GroupMember {
  groupId  String
  group    GroupTrip @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

/// A stop someone put in a group trip. `item` is the cart line as the browser stores it.
model GroupItem {
  id        String      @id @default(cuid())
  groupId   String
  group     GroupTrip   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemId    String
  item      Json
  addedById String
  addedBy   User        @relation(fields: [addedById], references: [id], onDelete: Cascade)
  votes     GroupVote[]
  createdAt DateTime    @default(now())

  @@unique([groupId, itemId])
}

model GroupVote {
  groupItemId String
  groupItem   GroupItem @relation(fields: [groupItemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupItemId, userId])
}
