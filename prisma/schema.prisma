generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  BACKPACKER
  BUDGET
  MIDRANGE
  LUXURY
}

enum ItemCategory {
  STAY
  EXPERIENCE
  FOOD
  ESIM
  GEAR
  TRANSIT
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  BLOG
}

enum CouponType {
  PLATFORM // our link + our exclusive code
  PUBLIC // our link + public brand promo
  CREATOR // creator's link + creator code (attribution kept)
}

enum Sentiment {
  MUST_VISIT
  RECOMMENDED
  OPTIONAL
  AVOID
}

enum Crowd {
  LOW
  MEDIUM
  HIGH
}

/// "Best time to go": typical weather and crowds for one month of the year.
model DestinationMonth {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  /// 1 = January.
  month         Int
  highC         Int?
  lowC          Int?
  rainMm        Int?
  crowd         Crowd?
  note          String?

  @@unique([destinationId, month])
}

/// "Before you go": one practical checklist entry (visa, money, health…).
model DestinationTip {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  /// Group heading, e.g. "Entry" or "Health".
  topic         String
  title         String
  body          String
  sourceUrl     String?
  position      Int         @default(0)
}

enum PhotoSource {
  OTA
  OEMBED
  WEBSITE
  UNSPLASH
  PEXELS
  PLACEHOLDER
}

model Destination {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  country          String
  summary          String
  heroPhotoUrl     String?
  /// Fictional demo content; the site shows a banner on it.
  isSample         Boolean            @default(false)
  /// Where the month-by-month weather figures come from.
  climateSourceUrl String?
  places           Place[]
  itineraries      Itinerary[]
  posts            Post[]
  months           DestinationMonth[]
  tips             DestinationTip[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Creator {
  id             String          @id @default(cuid())
  handle         String          @unique
  name           String
  platform       Platform
  /// Main link: where the creator's name button goes.
  profileUrl     String
  instagramUrl   String?
  facebookUrl    String?
  xUrl           String?
  tiktokUrl      String?
  youtubeUrl     String?
  pinterestUrl   String?
  websiteUrl     String?
  avatarUrl      String?
  bio            String?
  itineraries    Itinerary[]
  coupons        Coupon[]
  affiliateLinks AffiliateLink[]
  createdAt      DateTime        @default(now())
}

model Itinerary {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  summary       String
  tier          Tier
  days          Int
  sourceUrl     String
  /// The site owner's own commentary on this itinerary ("Nowfel's take"). Written in the admin panel.
  editorTake    String?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  items         Item[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
  @@index([creatorId])
}

/// A canonical spot shared across creators. Consensus = distinct creators whose items point at the same Place.
model Place {
  id            String       @id @default(cuid())
  slug          String
  name          String
  category      ItemCategory
  /// Neighbourhood or island, e.g. "Ubud" or "Nusa Penida".
  area          String?
  /// One or two sentences: what it is and why it's worth knowing (history, fame).
  blurb         String?
  tip           String?
  /// Venue's own site; its share image (og:image) is used as the place photo.
  website       String?
  /// Extra photo links added in admin, shown first in the place's photo gallery.
  photos        String[]     @default([])
  /// Map pin. Approximate is fine; travellers get "Open in Google Maps" for exact directions.
  lat           Float?
  lng           Float?
  destinationId String
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  items         Item[]

  @@unique([destinationId, slug])
}

model Item {
  id             String          @id @default(cuid())
  day            Int
  position       Int
  name           String
  note           String?
  category       ItemCategory
  priceCents     Int? // null = creator didn't give a price
  priceNote      String? // creator's own wording, e.g. "a couple bucks a day"
  sentiment      Sentiment?
  currency       String          @default("USD")
  /// Where we found the price when the creator didn't give one (official site, ticket office, booking platform).
  priceSourceUrl String?
  unit           String? // "night", "person", "day"
  quantity       Int             @default(1)
  itineraryId    String
  itinerary      Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  placeId        String?
  place          Place?          @relation(fields: [placeId], references: [id], onDelete: SetNull)
  vendorId       String?
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  links          AffiliateLink[]

  @@index([itineraryId, day, position])
  @@index([placeId])
}

model Vendor {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  homepage       String
  items          Item[]
  affiliateLinks AffiliateLink[]
  coupons        Coupon[]
}

/// creatorId null = our platform deep link; set = creator's original link.
model AffiliateLink {
  id        String   @id @default(cuid())
  url       String
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  creatorId String?
  creator   Creator? @relation(fields: [creatorId], references: [id])

  @@index([itemId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String
  type        CouponType
  description String?
  vendorId    String
  vendor      Vendor     @relation(fields: [vendorId], references: [id])
  creatorId   String?
  creator     Creator?   @relation(fields: [creatorId], references: [id])
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean    @default(true)

  @@index([vendorId, type, active])
}

/// One eSIM data plan for a country, loaded from data/esim/*.json.
model EsimPlan {
  id         String   @id @default(cuid())
  country    String
  provider   String
  name       String
  /// Null = unlimited.
  dataMb     Int?
  days       Int
  priceCents Int
  currency   String   @default("USD")
  network    String?
  speed      String?
  hotspot    Boolean?
  notes      String?
  url        String
  sourceUrl  String?
  checkedAt  DateTime

  @@index([country])
}

model PhotoCache {
  id          String      @id @default(cuid())
  key         String      @unique
  source      PhotoSource
  url         String
  attribution String?
  /// Photographer's profile page, linked from the credit line.
  creditUrl   String?
  fetchedAt   DateTime    @default(now())
}

/// Content the deploy seed has already loaded once ("itinerary:<slug>", "destination:<slug>"), so new entries in data/
/// get added on deploy while anything edited or deleted in the admin panel stays that way.
model SeedLog {
  key      String   @id
  loadedAt DateTime @default(now())
}

/// The person behind the site, shown on /about and next to their takes on itineraries. One row, id "me".
model Editor {
  id           String   @id @default("me")
  name         String
  tagline      String?
  /// Paragraphs separated by blank lines.
  bio          String
  photoUrl     String?
  email        String?
  instagramUrl String?
  updatedAt    DateTime @updatedAt
}

/// People who signed up for email: from the footer form, or by asking for their trip plan by email.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  /// Where they signed up: "footer" or "trip".
  source         String
  /// Last trip plan link they asked to have emailed.
  tripUrl        String?
  lastEmailedAt  DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Blog posts, written in Admin > Blog. Body is simple Markdown (headings, lists, links, images, bold/italic).
model Post {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  /// One or two sentences for the blog list, search results and share previews.
  excerpt       String?
  body          String
  coverUrl      String?
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  published     Boolean      @default(false)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([published, publishedAt])
}
